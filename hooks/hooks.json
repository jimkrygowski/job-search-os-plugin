{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/session_start.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*Gmail.*__(send_message|reply|forward)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/guard_send.py"
            ]
          }
        ]
      }
    ]
  }
}
